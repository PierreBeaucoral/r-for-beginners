# Caches et intermédiaires Quarto/R
/.quarto/
.Rproj.user
.Rhistory
*_cache/
*_files/
.DS_Store
**/*.quarto_ipynb

# _freeze/ EST versionné (résultats R figés) : ne PAS l'ignorer.

# Sortie rendue : construite et déployée par GitHub Actions
/docs/

# Artefacts de rendu en place et sorties d'exercices
/*.html
/seances/*.html
/slides/*.html
/Rplots.pdf
output/

# Generated at render time by tools/make_scripts.R
/scripts/

# Review screenshots (large, regenerable)
quality_reports/referee_reports/screens/
.playwright-mcp/

# French pages must NOT be frozen: rendering a .fr.qmd directly stores image paths
# under X.fr_files/, which break once babelquarto renames the page X.qmd.
# babelquarto re-runs the French R code at each render instead.
_freeze/**/*.fr/
